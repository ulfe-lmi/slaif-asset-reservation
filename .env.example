# Copy to .env for host-side local development commands run with
# `uv run --env-file .env ...`. Django does not automatically load this file.
# Docker Compose supplies its own container-internal DATABASE_URL using host `db`.
# Never commit real secrets.

DJANGO_SETTINGS_MODULE=slaif_reservation.config.settings.local
SLAIF_DJANGO_SECRET_KEY=change-me-for-local-development-only
SLAIF_DEBUG=false
SLAIF_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
SLAIF_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SLAIF_ENABLE_API_DOCS=true
SLAIF_PUBLIC_API_DOCS=false
SLAIF_SECURE_HSTS_SECONDS=0
SLAIF_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SLAIF_SECURE_HSTS_PRELOAD=false
SLAIF_API_TOKEN_PEPPER=unsafe-development-api-token-pepper-do-not-use-in-production
SLAIF_API_TOKEN_MAX_LIFETIME_DAYS=90
DATABASE_URL=postgres://slaif:slaif@localhost:5432/slaif_reservation

# Production deployments must set a real secret key, explicit hosts/origins,
# HTTPS/proxy settings, a protected PostgreSQL connection outside the image,
# and a distinct API token pepper generated and stored outside the repository.
