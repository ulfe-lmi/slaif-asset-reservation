# Copy to deploy/env.production on the deployment host and replace every placeholder.
# This example is intentionally not loaded by Django automatically and contains no real secrets.

DJANGO_SETTINGS_MODULE=slaif_reservation.config.settings.production
SLAIF_DJANGO_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_BYTES_FROM_A_PROTECTED_SECRET_STORE
SLAIF_ALLOWED_HOSTS=reservation.example.org,127.0.0.1
SLAIF_CSRF_TRUSTED_ORIGINS=https://reservation.example.org
SLAIF_ENABLE_API_DOCS=false
SLAIF_PUBLIC_API_DOCS=false
SLAIF_SECURE_SSL_REDIRECT=true
# HSTS stays disabled until the final HTTPS hostname is verified.
# Out-of-contract combinations fail closed at settings load: a non-zero
# SLAIF_SECURE_HSTS_SECONDS requires SLAIF_SECURE_SSL_REDIRECT=true, and
# the subdomain/preload flags require a non-zero SLAIF_SECURE_HSTS_SECONDS.
SLAIF_SECURE_HSTS_SECONDS=0
SLAIF_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SLAIF_SECURE_HSTS_PRELOAD=false
SLAIF_API_TOKEN_PEPPER=REPLACE_WITH_DISTINCT_AT_LEAST_32_BYTE_PEPPER
SLAIF_API_TOKEN_MAX_LIFETIME_DAYS=90
DATABASE_URL=postgres://slaif:REPLACE_WITH_DATABASE_PASSWORD@db:5432/slaif_reservation

# Explicit trusted proxy peers: the ONLY peers allowed to supply
# X-Forwarded-Proto / X-Forwarded-For. Entries must be explicit IP
# addresses or point-to-point networks (/31 IPv4, /127 IPv6); broad
# ranges are rejected. Supported values:
# - 127.0.0.1: the in-container healthcheck probe (see INSTALL.md step 2);
# - the Docker bridge gateway IP: the peer presented by the host proxy
#   when it connects to the published app port. Discover it on the host,
#   e.g. `ip route show default dev docker0` or
#   `docker network inspect <network> --format '{{range .IPAM.Config}}{{.Gateway}}{{end}}'`.
SLAIF_TRUSTED_PROXY_PEERS=127.0.0.1,REPLACE_WITH_DOCKER_BRIDGE_GATEWAY_IP

# Shared fixed-window PostgreSQL abuse controls; positive values are required.
# Login budgets are shared by the member and Administration login routes.
SLAIF_LOGIN_IP_LIMIT=30
SLAIF_LOGIN_IDENTITY_LIMIT=10
SLAIF_LOGIN_WINDOW_SECONDS=300
# API source budget is checked before bearer authentication; owner/token
# budgets apply after successful authentication, including denied operations.
SLAIF_API_IP_LIMIT=1200
SLAIF_API_OWNER_LIMIT=600
SLAIF_API_TOKEN_LIMIT=300
SLAIF_API_WINDOW_SECONDS=60
