{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/slaif-asset-reservation/bootstrap-assets.schema.json",
  "title": "SLAIF Asset Reservation bootstrap inventory",
  "type": "object",
  "required": [
    "schema_version",
    "defaults",
    "assets"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "defaults": {
      "type": "object",
      "required": [
        "timezone"
      ],
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": [
        "slug",
        "name",
        "kind",
        "active",
        "reservable"
      ],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "kind": {
          "enum": [
            "machine",
            "gpu",
            "cpu_pool",
            "service",
            "other"
          ]
        },
        "parent": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "location": {
          "type": "string",
          "maxLength": 180
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "active": {
          "type": "boolean"
        },
        "reservable": {
          "type": "boolean"
        },
        "verification_required": {
          "type": "boolean"
        }
      }
    }
  }
}
